# Cuenta de servicio de Firebase (Configuración del proyecto → Cuentas de servicio → Generar clave).
# Pega el JSON en una sola línea, o su versión en base64. Solo servidor; nunca la subas a git.
FIREBASE_SERVICE_ACCOUNT=
# Usuario de plataforma, se crea la primera vez que arranca la app
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Solo para pruebas locales con el emulador:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-loyalty
