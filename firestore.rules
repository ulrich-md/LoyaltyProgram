rules_version = '2';
// Todo el acceso ocurre desde el servidor con la cuenta de servicio (Admin SDK, que ignora estas reglas).
// Cualquier acceso directo desde un navegador o app queda denegado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
